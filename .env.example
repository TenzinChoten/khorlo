# Copy to .env and fill in values. Never commit .env.

# Database
DATABASE_URL=
DIRECT_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional persistent folder for legacy /uploads files (avatars, portfolio, older campaign images)
# UPLOAD_DIR=/var/data/uploads

# Supabase Storage (backend / Render only — never expose SUPABASE_SECRET_KEY to Vite or the browser)
# Campaign images are stored in the public "campaign-images" bucket under campaigns/<campaignId>/
# Uploads before create use campaigns/pending/<businessId>/ and are moved after the campaign exists
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Razorpay (backend only — never expose KEY_SECRET to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional webhook secret for subscription events
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_CURRENCY=INR
