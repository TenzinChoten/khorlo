# Copy to .env and fill in values. Never commit .env.

# Database
DATABASE_URL=
DIRECT_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Razorpay (backend only — never expose KEY_SECRET to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional webhook secret for subscription events
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_CURRENCY=INR
