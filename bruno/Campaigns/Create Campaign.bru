meta {
  name: Create Campaign
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/campaigns
  body: json
  auth: none
}

body:json {
  {
    "title": "Promote our Coffee Brand",
    "description": "Looking for food creators to promote our new artisan coffee line.",
    "country": "USA",
    "state": "California",
    "city": "Los Angeles",
    "locationType": "ONLINE",
    "compensationType": "PAID",
    "budget": 500,
    "applicationDeadline": "2026-10-01",
    "images": [
      "https://example.com/coffee1.jpg",
      "https://example.com/coffee2.jpg"
    ],
    "contentNiches": [
      "Food",
      "Lifestyle"
    ],
    "contentFormats": [
      {
        "format": "Instagram Reel",
        "quantity": 2
      },
      {
        "format": "Instagram Story",
        "quantity": 3
      }
    ]
  }
}
