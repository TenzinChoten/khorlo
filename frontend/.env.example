# Public API origin only. Do not put JWT secrets, database URLs, or SMTP passwords here.
# VITE_* variables are exposed to the browser; RAZORPAY_KEY_ID (public key only) is injected via vite.config.js.

# Local development (also the default in .env.development)
VITE_API_URL=http://localhost:3000
# Public Razorpay key only (must match backend RAZORPAY_KEY_ID on Render)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Production / Vercel (also the default in .env.production)
# VITE_API_URL=https://khorlo.onrender.com
